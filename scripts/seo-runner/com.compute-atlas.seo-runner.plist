<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.compute-atlas.seo-runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_PATH__/scripts/seo-runner/run-session.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>

  <!--
    Fail-closed until SEO_RUNNER_ENABLED=true is uncommented below — until
    then run-session.sh's kill switch keeps this job a no-op every tick.

    UNATTENDED=1 is what actually lets a green, mergeable PR get squash-
    merged to main. Leave it OFF (commented out) for the supervised first
    run or two: the runner will still build the session, open the PR, and
    watch CI, but will stop short of merging and log a manual
    `gh pr merge <n> --squash --delete-branch` command instead. Only
    uncomment UNATTENDED once you trust the gate unattended.

    launchd runs with a bare PATH, so the binaries run-session.sh calls
    (claude, gh, git, python3 — Homebrew installs them in /opt/homebrew/bin)
    must be on PATH here or the job fails to find them. Adjust the prefix
    if your install differs.

    Two more things launchd's environment needs that this file does NOT
    set (by design — they're either secrets or host-specific auth state,
    not config): a non-interactive `git push` path (see the CAST_PUSH_OK
    escape hatch) and an already-authenticated `gh` CLI (`gh auth status`)
    reachable from this same environment. Neither is set here; verify both
    work from a `launchctl bootstrap`-equivalent shell before enabling.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- <key>SEO_RUNNER_ENABLED</key><string>true</string> -->
    <!-- <key>UNATTENDED</key><string>1</string> -->
  </dict>

  <!--
    Daily at 13:00 local time, one session per run — same slot as the
    discovery job. Midday is when the Mac is normally awake and lid-open;
    an overnight slot gets skipped whenever the machine is asleep, since
    launchd defers a missed calendar interval to the next wake rather than
    firing it late.
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO_PATH__/seo-runner-logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO_PATH__/seo-runner-logs/launchd.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
