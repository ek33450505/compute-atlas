<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.compute-atlas.discovery</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_PATH__/scripts/discovery/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>

  <!--
    launchd runs with a bare PATH, so the binaries run.sh calls (claude, node,
    npx — Homebrew installs them in /opt/homebrew/bin) must be on PATH here or
    the job fails to find them. Adjust the prefix if your install differs.

    DISCOVERY_ENABLED is intentionally NOT set — run.sh's fail-closed kill
    switch keeps the job a no-op until you enable it. To actually run, uncomment
    DISCOVERY_ENABLED below and set API_BASE_URL to your deployment. The admin
    token is never set here: the submit step reads it from .env.local via
    `tsx --env-file`, keeping the secret out of this file.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- <key>DISCOVERY_ENABLED</key><string>true</string> -->
    <!-- <key>API_BASE_URL</key><string>https://www.compute-atlas.com</string> -->
  </dict>

  <!--
    Mon/Wed/Fri at 13:00 local time (planned for 2026-11-02; daily before).
    There is no date gate in this file: launchd applies it from the moment it
    is reinstalled into ~/Library/LaunchAgents and the job reloaded. Each run
    takes STATES_PER_RUN (default 3) states from the 51-state rotation, so a
    full cycle is 17 runs, about 6 weeks. Runs midday, when the Mac is normally
    awake and lid-open: an overnight (03:00) slot was skipped whenever the
    machine was asleep, since launchd defers a missed calendar interval to the
    next wake. The watchdog cron in .github/workflows/discovery-watchdog.yml
    and the 84h stale thresholds follow this schedule and must change with it.
    launchd Weekday: 0/7 = Sunday, 1 = Monday.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__REPO_PATH__/discovery-logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO_PATH__/discovery-logs/launchd.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
