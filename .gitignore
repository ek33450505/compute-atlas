# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal planning notes — kept local, not part of the public repo
/docs/NEXT-SESSION.md
/docs/ROADMAP.md
/docs/session-archive-*.md
/docs/archive/
/docs/track-c-candidate-ledger.md
/docs/seo-promotion-checklist.md
/docs/manual-steps.md
/plans/
/scratchpad/

# discovery pipeline run logs / candidate dumps — local only
/discovery-logs/
# leftover local logs from the removed seo-runner
/seo-runner-logs/

# Banner build intermediate — regenerate with scripts/make-banner.py
docs/media/banner.svg

# MapLibre worker + its shared sibling, copied from node_modules by
# scripts/copy-maplibre-worker.mjs on prebuild/predev — generated, never edited
/public/maplibre/

# Wave scratch artifacts — research working dirs, not part of the app
wave-*/

# Claude Code agent tooling (installed locally, not part of the project)
/.claude/skills/
/skills-lock.json

# Candidate files written by the data pipeline before review
*.next.json

# Generated by `prebuild`/`predev` from the data snapshot (not committed)
/components/home/hero-plate-paths.ts
/public/data/hero-points.json
/public/data/pipeline-history.json

# Local data snapshot exported from Neon by ensure-data-snapshot / `npm run db:export`;
# nothing under data/ is ever committed (Neon is the only home of this data)
/data/

# Bench corpus and results: real facility records (pages, targets, truth, result files); local-only, regenerated by bench/build-targets.mjs and fetch-pages.mjs
/scripts/discovery/bench/pages.json
/scripts/discovery/bench/targets.json
/scripts/discovery/bench/truth.json
/scripts/discovery/bench/result-*.json
/scripts/discovery/bench/baseline-preGW/*.json
