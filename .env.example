# Neon Postgres pooled connection string (Project > Connect > Pooled connection).
DATABASE_URL=

# Bearer token required by the admin-only write API (Phase 2+). Generate a
# long random value and keep it out of version control. Also gates the
# admin UI's `admin_session` cookie (proxy.ts / lib/admin-session.ts).
API_ADMIN_TOKEN=

# PBKDF2 salt for the admin-UI password login (app/admin/login/actions.ts).
# Required: login fails closed (every attempt rejected) if unset.
API_ADMIN_TOKEN_SALT=

# Salt for hashing submitter IPs used for public-contribution rate limiting.
# REQUIRED in production — hashIp() throws on Vercel production if unset,
# rather than silently hashing with the repo-public default salt. Falls back
# to a built-in default in dev, tests, and preview deployments (previews do
# not inherit Production-scoped env vars).
CONTRIBUTE_IP_SALT=

# Email alerts (Resend) — all optional. If RESEND_API_KEY is unset, subscription
# confirm/alert sends become a logged no-op, so builds, tests, and CI run fine
# without it (lib/email.ts).

# Resend API key for sending the double-opt-in confirm + change-alert emails.
RESEND_API_KEY=

# "From" address for alert emails. Falls back to
# "Compute Atlas <alerts@compute-atlas.com>" if unset.
EMAIL_FROM=

# Recipient for contact-form notification emails (lib/email.ts). If unset,
# the message is still stored — only the notification send is skipped
# (logged, not an error).
CONTACT_TO_EMAIL=

# Public base URL for links inside emails (confirm/unsubscribe). Falls back to
# the built-in siteConfig.url if unset.
NEXT_PUBLIC_SITE_URL=

# Monthly state digest (app/api/cron/state-digest) — DISABLED BY DEFAULT, and
# deliberately so. Leave BOTH of these unset unless you are turning the digest
# on on purpose: the `state` subscription rows predate the feature and have
# never received mail, so enabling it resumes mail to a long-silent list.
# Read the route file's header first — it carries the enable checklist,
# including the idempotency prerequisite that must be closed BEFORE the switch
# is flipped (nothing here is idempotent yet; a repeat run re-sends).

# Bearer secret Vercel Cron presents as `Authorization: Bearer <value>`. Unset
# means every cron-path caller is rejected (fail-closed). MUST NOT equal
# API_ADMIN_TOKEN — if they match, the admin `?since=&until=` recovery path
# becomes unreachable (the cron check short-circuits first).
CRON_SECRET=

# Kill switch for the digest. Only the exact string "true" enables it; unset or
# anything else returns 503 and sends nothing.
STATE_DIGEST_ENABLED=
