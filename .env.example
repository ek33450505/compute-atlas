# Neon Postgres pooled connection string (Project > Connect > Pooled connection).
DATABASE_URL=

# Bearer token required by the admin-only write API (Phase 2+). Generate a
# long random value and keep it out of version control. Also gates the
# admin UI's `admin_session` cookie (proxy.ts / lib/admin-session.ts).
API_ADMIN_TOKEN=

# Optional: salt for hashing submitter IPs used only for public-contribution rate limiting.
# Falls back to a built-in default if unset. Set a random value in production for stronger hashing.
CONTRIBUTE_IP_SALT=

# Email alerts (Resend) — all optional. If RESEND_API_KEY is unset, subscription
# confirm/alert sends become a logged no-op, so builds, tests, and CI run fine
# without it (lib/email.ts).

# Resend API key for sending the double-opt-in confirm + change-alert emails.
RESEND_API_KEY=

# "From" address for alert emails. Falls back to
# "Compute Atlas <alerts@compute-atlas.com>" if unset.
EMAIL_FROM=

# Public base URL for links inside emails (confirm/unsubscribe). Falls back to
# the built-in siteConfig.url if unset.
NEXT_PUBLIC_SITE_URL=
